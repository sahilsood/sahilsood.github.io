---
import InteractiveDashboard from "../components/InteractiveDashboard.jsx";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { skills } from "../data/skills";
import { projects } from "../data/projects";

---

<!-- Page composition: foldable device hero → skills marquee → experience timeline → projects gallery → footer -->
<Layout>
  <main class="ambient-field relative min-h-screen overflow-clip text-slate-200">
    <div class="relative mx-auto flex min-h-screen w-full max-w-6xl flex-col justify-between py-5">
      <div class="pointer-events-none absolute left-1/2 top-1/3 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-red-500/10 blur-3xl"></div>

      <header class="sticky top-0 z-40 mb-6 w-full border-b border-white/5 bg-[#08080c]/85 py-3 backdrop-blur-md">
        <div class="mx-auto flex w-full max-w-4xl items-center justify-between gap-4">
          <a href="#top" class="font-mono text-sm font-semibold tracking-tight text-slate-100">
            <span class="text-red-400">~</span> sahil.sood
          </a>
          <div class="hidden items-center gap-3 md:flex">
            <a
              href={site.links.linkedin}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-[#222a35] bg-[#11161d] px-4 py-2 font-mono text-sm text-slate-300 transition hover:border-red-400/50 hover:text-red-300"
            >
              get_in_touch
            </a>
            <a
              href={site.resumeUrl}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-red-400/40 bg-red-400/10 px-4 py-2 font-mono text-sm font-semibold text-red-300 transition hover:bg-red-400/20"
            >
              resume.pdf
            </a>
          </div>
        </div>
      </header>

      <section id="top" class="relative flex flex-1 items-center justify-center py-6">
        <InteractiveDashboard client:load />
      </section>

      <section id="skills" class="w-full py-8">
        <div class="marquee flex items-stretch overflow-hidden rounded-lg border border-[#3a1f22] bg-[#100a0b]">
          <div class="flex flex-none items-center gap-2 border-r border-[#3a1f22] bg-red-500/15 px-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-red-300">
            <span class="ticker-dot h-2 w-2 rounded-full bg-red-500"></span>
            Live&nbsp;Skills
          </div>
          <div class="marquee__viewport relative flex-1 overflow-hidden py-3">
            <div class="marquee__track">
              {[...skills, ...skills].map((skill) => (
                <span class="marquee__item">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="experience" class="mx-auto w-full max-w-4xl py-12">
        <h2 class="mb-8 text-center text-3xl font-bold text-slate-100">Experience</h2>
        <div class="timeline grid grid-cols-[2.75rem_1fr] gap-4">
          <div class="timeline-rail" aria-hidden="true">
            <div class="timeline-track"></div>
            <div class="timeline-hilt"></div>
            <div class="timeline-blade"></div>
          </div>
          <div class="space-y-6">
          <div class="glass-panel p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#2a3441] bg-white p-2">
                  <img src="img/truist.png" alt="Truist Financial" class="h-full w-full object-contain" />
                </div>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-slate-100">Senior Android Engineer & Mobile Team Lead</h3>
                <p class="font-mono text-sm text-red-400">Truist Financial • July 2020 - Present</p>
                <p class="mt-2 text-slate-400">Leading mobile development initiatives and mentoring junior developers.</p>
              </div>
            </div>
          </div>

          <div class="glass-panel p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#2a3441] bg-white p-2">
                  <img src="img/hu.png" alt="Harrisburg University" class="h-full w-full object-contain" />
                </div>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-slate-100">Masters in Information Systems Engineering and Management</h3>
                <p class="font-mono text-sm text-red-400">Harrisburg University of Science and Technology • 2025</p>
                <p class="mt-2 text-slate-400">GPA: 4.0 (On a scale of 4.00)</p>
              </div>
            </div>
          </div>

          <div class="glass-panel p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#2a3441] bg-white p-2">
                  <img src="img/uncc-logo.png" alt="University of North Carolina at Charlotte" class="h-full w-full object-contain" />
                </div>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-slate-100">Masters in Computer Science</h3>
                <p class="font-mono text-sm text-red-400">University of North Carolina at Charlotte • 2020</p>
                <p class="mt-2 text-slate-400">GPA: 3.7 (On a scale of 4.00)</p>
              </div>
            </div>
          </div>

          <div class="glass-panel p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#2a3441] bg-white p-2">
                  <img src="img/cci.png" alt="College of Computing and Informatics" class="h-full w-full object-contain" />
                </div>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-slate-100">Graduate Teaching Assistant</h3>
                <p class="font-mono text-sm text-red-400">College of Computing and Informatics • August 2019 - May 2020</p>
                <p class="mt-2 text-slate-400">Supported computing coursework, grading, and student mentoring.</p>
              </div>
            </div>
          </div>

          <div class="glass-panel p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#2a3441] bg-white p-2">
                  <img src="img/c-logo.png" alt="Cognizant Technology Solutions" class="h-full w-full object-contain" />
                </div>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-slate-100">Programmer Analyst</h3>
                <p class="font-mono text-sm text-red-400">Cognizant Technology Solutions • January 2016 - June 2017</p>
                <p class="mt-2 text-slate-400">Developed enterprise applications and maintained legacy systems.</p>
              </div>
            </div>
          </div>

          <div class="glass-panel p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#2a3441] bg-white p-2">
                  <img src="img/cec.png" alt="Chandigarh Engineering College" class="h-full w-full object-contain" />
                </div>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-slate-100">Bachelor of Technology in Computer Science</h3>
                <p class="font-mono text-sm text-red-400">Chandigarh Engineering College • 2015</p>
                <p class="mt-2 text-slate-400">GPA: 3.67 (On a scale of 4.00)</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </section>

      <section id="projects" class="projects-pin-section">
        <div class="projects-pin">
          <div class="projects-pin__inner">
            <h2 class="mb-8 text-center text-3xl font-bold text-slate-100">Projects</h2>
            <div class="projects-viewport" id="projectsViewport">
              <div class="projects-track">
            {projects.map((project) => (
              <a href={project.href} target="_blank" rel="noreferrer" class="project-card">
                <div class="project-card__media">
                  <img src={project.image} alt={project.title} loading="lazy" />
                  <span class="project-card__tag">{project.tag}</span>
                </div>
                <div class="project-card__body">
                  <p class="project-card__date">{project.date}</p>
                  <h3 class="project-card__title">{project.title}</h3>
                  <p class="project-card__desc">{project.description}</p>
                </div>
              </a>
            ))}
              </div>
            </div>
            <a href={site.links.github} target="_blank" rel="noreferrer" class="mt-4 block text-center font-mono text-xs uppercase tracking-[0.2em] text-red-300 transition hover:text-red-200">explore more on github &rarr;</a>
          </div>
        </div>
      </section>

      <footer class="mx-auto mt-6 w-full max-w-4xl border-t border-[#222a35] pt-5 text-center font-mono text-xs text-slate-500">
        <p>{site.copyright}</p>
        <p class="mt-1 text-red-400/80">May the Force be with you.</p>
      </footer>
    </div>
  </main>

  <script>
    const rail = document.querySelector(".timeline-rail");
    const blade = document.querySelector(".timeline-blade");
    if (rail && blade) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const r = rail.getBoundingClientRect();
        const mid = window.innerHeight * 0.5;
        const maxH = Math.max(0, r.height - 46);
        const h = Math.max(0, Math.min(maxH, mid - r.top - 46));
        blade.style.height = h + "px";
      };
      const request = () => {
        if (!frame) frame = window.requestAnimationFrame(update);
      };
      window.addEventListener("scroll", request, { passive: true });
      window.addEventListener("resize", request, { passive: true });
      update();
    }
  </script>

  <script>
    const projectsSection = document.querySelector(".projects-pin-section");
    const projectsViewport = document.querySelector(".projects-viewport");
    const projectsTrack = document.querySelector(".projects-track");
    if (projectsSection && projectsViewport && projectsTrack) {
      let maxTranslate = 0;

      const apply = () => {
        const rect = projectsSection.getBoundingClientRect();
        const total = projectsSection.offsetHeight - window.innerHeight;
        const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
        projectsTrack.style.transform = `translate3d(${-progress * maxTranslate}px, 0, 0)`;
      };

      const measure = () => {
        maxTranslate = Math.max(0, projectsTrack.scrollWidth - projectsViewport.clientWidth);
        projectsSection.style.height = `${window.innerHeight + maxTranslate}px`;
        apply();
      };

      window.addEventListener("scroll", apply, { passive: true });
      window.addEventListener("resize", measure);
      measure();
    }
  </script>
</Layout>
